<div id="background">
  <div id="page">
    <div id="header">
      <div id="logo">
        <a href="/"><img src="images/logo.png" alt="LOGO" height="100" width="200"></a>
      </div>
      <div id="navigation">
        <ul>
          <li><a href="/">Home</a></li>
          <li class="selected"><a href="/travel">Travel</a></li>
          <li><a href="/rooms">Rooms</a></li>
          <li><a href="/meals">Meals</a></li>
          <li><a href="/news">News</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>
    <div id="contents">
      <div class="box">
        <div>
          <div class="body">
            <h1>Travel</h1>
            <ul id="sites">
              {{#each trips}}
              <li>
                <a href="/api/trips/{{code}}"><img src="images/{{image}}" alt="Img"></a>
                <h2><a href="/api/trips/{{code}}">{{name}}</a></h2>
                <p>{{description}}</p>
              </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div id="footer">
    <div>
      <ul class="navigation">
        <li><a href="/">Home</a></li>
        <li class="active"><a href="/travel">Travel</a></li>
        <li><a href="/rooms">Rooms</a></li>
